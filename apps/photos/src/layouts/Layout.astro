---
import favicon from '../assets/favicon.svg';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title,
	description = 'Sports, street and streetwear photography by Jimi Ademola.',
	noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — Jimi Ademola` : 'Jimi Ademola — Photography';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/jimiademola-og.png', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href={favicon.src} type="image/svg+xml" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		min-height: 100vh;
		/* The original faint cyan tint. */
		background-color: rgba(0, 241, 249, 0.05);
		-webkit-font-smoothing: antialiased;
	}
</style>
