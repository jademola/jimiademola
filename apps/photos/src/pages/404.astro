---
import backgroundImage from "../assets/background.png";
import Logo from "../assets/favicon.svg";
import Cursor from "../assets/cursor.png";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home" language="en">
	<body>
		<div>
            <div
			id="background"
			style={`background-image: url(${backgroundImage.src}); background-size: cover;`}
		>
		</div>

		<!-- use as anchor -->
		<div id="home">
				<a id="logo" href="/photos"><img  src={Logo.src} alt="Logo" /></a>
		</div>
        </div>
        
		<slot />
	</body>
</Layout>

<style>
	#background {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(7px);
	}

	#home {
		position: fixed;
		inset: 0;
		display: flex;
		justify-content: center;
		align-items: center;
		height: 100vh;
		z-index: 1;
	}

	#logo {
		display: block;
		margin: auto;
		width: 20vw;
        cursor: url(../assets/cursor.png), auto;
	}
	/* #logo:hover {
		transform: scale(1.1);
		transition: transform 0.3s ease-in-out;
	}
	bugged with weird grey border issue */

	@media (max-width: 640px) {
		#logo {
			width: 40vw;
		}
	}
</style>
