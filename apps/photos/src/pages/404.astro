---
import { getImage } from 'astro:assets';
import backgroundImage from '../assets/background.png';
import Logo from '../assets/favicon.svg';
import Layout from '../layouts/Layout.astro';

// The original is a 13 MB, 5121px PNG. It's blurred on screen, so a 1920px
// webp looks identical at a fraction of the size.
const background = await getImage({
	src: backgroundImage,
	width: 1920,
	format: 'webp',
	quality: 70,
});
---

<Layout title="Not found" noindex>
	<div id="background" style={`background-image: url(${background.src});`}></div>

	<main id="home">
		<a id="logo" href="/" aria-label="Back to the gallery">
			<img src={Logo.src} alt="Jimi Ademola logo" />
		</a>
	</main>
</Layout>

<style>
	#background {
		position: fixed;
		inset: 0;
		z-index: -1;
		background-size: cover;
		background-position: center;
		filter: blur(7px);
		/* Keeps the blur from fading out at the screen edges. */
		transform: scale(1.04);
	}

	#home {
		position: fixed;
		inset: 0;
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 1;
	}

	#logo {
		display: block;
		width: 20vw;
	}

	#logo img {
		display: block;
		width: 100%;
	}

	@media (max-width: 640px) {
		#logo {
			width: 40vw;
		}
	}
</style>
