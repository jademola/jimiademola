---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import filmstripWhite from '../assets/icons/filmstrip-white.png';
import filmstripBlack from '../assets/icons/filmstrip-black.png';

const portfolioImages = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/portfolio/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);

function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const photos = await Promise.all(
	shuffle(
		Object.entries(portfolioImages).map(([path, module]) => ({
			img: module.default,
			category: path
				.replace('../assets/portfolio/', '')
				.split('/')
				.slice(0, -1)
				.join('/') || 'uncategorized',
		})),
	).map(async ({ img, category }) => ({
		img,
		category,
		full: await getImage({ src: img, width: 2000, format: 'webp', quality: 80 }),
	})),
);

const categories = [...new Set(photos.map(({ category }) => category))].sort();

function categoryLabel(category: string): string {
	return category
		.split('/')
		.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
		.join(' / ');
}
---

<Layout title="Gallery" language="en">
	<main>
		<body id="body">
			<header class="site-header">
				<a id="videos-link" href="/videos">
					<img src={filmstripBlack.src} alt="See Videos" width="50" height="50" />
				</a>
				<h1>Jimi Ademola</h1>
				<p>Photography</p>
			
		</header>

		<nav class="gallery-filters" aria-label="Filter photos by type">
			<button type="button" class="filter-button is-active" data-filter="all" aria-pressed="true">
				All
			</button>
			{categories.map((category) => (
				<button type="button" class="filter-button" data-filter={category} aria-pressed="false">
					{categoryLabel(category)}
				</button>
			))}
		</nav>

		<div class="masonry-gallery" id="portfolio-gallery">
			{photos.map(({ img, full, category }, i) => (
			<a
      		href={full.src}
     		data-pswp-width={full.attributes.width}
      		data-pswp-height={full.attributes.height}
			data-category={category}
			class="masonry-item"
			target="_blank"
			rel="noopener"
			>
			<Image
				src={img}
				alt="Almost there..."
				widths={[400, 800, 1200]}
				sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
				loading={i < 3 ? 'eager' : 'lazy'}
				fetchpriority={i < 3 ? 'high' : 'auto'}
				decoding="async"
			/>
			</a>
		))}
		</div>
		</body>
	</main>

	<script>
		import PhotoSwipeLightbox from 'photoswipe/lightbox';
		import 'photoswipe/style.css';

		const lightbox = new PhotoSwipeLightbox({
			gallery: '#portfolio-gallery',
			children: 'a',
			pswpModule: () => import('photoswipe'),
		});

		lightbox.init();

		const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
		const galleryItems = document.querySelectorAll<HTMLElement>('.masonry-item');

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.filter;

				filterButtons.forEach((filterButton) => {
					filterButton.classList.toggle('is-active', filterButton === button);
					filterButton.setAttribute('aria-pressed', String(filterButton === button));
				});

				galleryItems.forEach((item) => {
					item.hidden = filter !== 'all' && item.dataset.category !== filter;
				});
			});
		});
	</script>
</Layout>

<style>
	#body {
		background-color: rgb(249, 248, 240);

	}

	.site-header {
		padding: 3rem 2rem 1rem;
		text-align: center;
	}

	.site-header h1 {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		color: rgb(0, 0, 0);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.site-header p {
		margin: 0.35rem 0 0;
		color: rgb(0, 0, 0);
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.8rem;
	}

	.gallery-filters {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		padding: 1rem 2rem 0.5rem;
	}

	.filter-button {
		padding: 0.5rem 0.85rem;
		border: 1px solid rgb(0, 0, 0);
		border-radius: 999px;
		background: transparent;
		color: rgb(0, 0, 0);
		font: inherit;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
	}

	.filter-button:hover,
	.filter-button.is-active {
		background: rgb(0, 0, 0);
		color: rgb(249, 248, 240);
	}

	.filter-button:focus-visible {
		outline: 2px solid rgb(0, 0, 0);
		outline-offset: 3px;
	}

	.masonry-gallery {
		column-count: 3;
		column-gap: 1.5rem;
		padding: 1rem 2rem 3rem;
	}

	@media (max-width: 1024px) {
		.masonry-gallery {
			column-count: 2;
		}
	}

	@media (max-width: 640px) {
		.masonry-gallery {
			column-count: 1;
			padding: 1rem 1rem 2rem;
		}
	}

	.masonry-item {
		display: block;
		break-inside: avoid;
		margin-bottom: 1.5rem;
	}

	.masonry-item[hidden] {
		display: none;
	}

	.masonry-item :global(img) {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0px;
		border: 1px solid rgb(221, 221, 221);
		transition: filter 0.3s ease;
	}

	.masonry-item:hover :global(img) {
		filter: brightness(0.85);
	}

	#videos-link {
		position: absolute;
		top: 1rem;
		right: 1rem;
		text-decoration: none;
		color: rgb(0, 0, 0);
	}
</style>
