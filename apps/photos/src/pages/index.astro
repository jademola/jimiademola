---
// src/layouts/Layout.astro
import backgroundImage from "../assets/background.png";
import Logo from "../assets/favicon.svg";
import Cursor from "../assets/cursor.png";

const { language, title } = Astro.props;
---

<!doctype html>
<html lang={language}>
	<head> </head>
	<body>
		<div>
            <div
			id="background"
			style={`background-image: url(${backgroundImage.src}); background-size: cover;`}
		>
		</div>

		<!-- use as anchor -->
		<div id="home">
				<a id="logo" href="/photos"><img  src={Logo.src} alt="Logo" /></a>
		</div>
        </div>
        
		<slot />
	</body>
</html>

<style>
	#background {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(7px);
	}

	#home {
		position: fixed;
		inset: 0;
		display: flex;
		justify-content: center;
		align-items: center;
		height: 100vh;
		z-index: 1;
	}

	#logo {
		display: block;
		margin: auto;
		width: 20%;
        cursor: url(../assets/cursor.png), auto;
	}
	/* #logo:hover {
		transform: scale(1.1);
		transition: transform 0.3s ease-in-out;
	}
	bugged with weird grey border issue */
</style>
