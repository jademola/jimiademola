---
import Head from "../components/Head.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<Head title="404 — Page not found" />
	</head>
	<body>
		<main class="page-shell">
			<div class="aurora aurora-one"></div>
			<div class="aurora aurora-two"></div>
			<div class="grid"></div>

			<section class="card" aria-labelledby="not-found-title">
				<p class="eyebrow">Lost signal</p>
				<div class="status-row" aria-hidden="true">
					<span class="orb orb-left"></span>
					<span class="code">404</span>
					<span class="orb orb-right"></span>
				</div>
				<h1 id="not-found-title">This page drifted off course.</h1>
				<p class="lede">
					The URL you followed does not exist here anymore, or it never existed at all.
					Either way, the quickest route back is below.
				</p>

				<div class="actions">
					<a class="primary" href="/">Go home</a>
					<a class="secondary" href="/">Try another route</a>
				</div>

				<p class="hint">
					If you expected something specific, double-check the address or head back to the
					starting point.
				</p>
			</section>
		</main>
	</body>
</html>

<style>
	:global(html, body) {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	:global(body) {
		font-family: Inter, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		background:
			radial-gradient(circle at top, rgba(103, 232, 249, 0.18), transparent 35%),
			linear-gradient(135deg, #08111f 0%, #0e1728 45%, #050814 100%);
		color: #eef2ff;
	}

	.page-shell {
		min-height: 100%;
		position: relative;
		overflow: hidden;
		display: grid;
		place-items: center;
		padding: 24px;
	}

	.grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(148, 163, 184, 0.09) 1px, transparent 1px),
			linear-gradient(90deg, rgba(148, 163, 184, 0.09) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: radial-gradient(circle at center, black 30%, transparent 78%);
		opacity: 0.55;
	}

	.aurora {
		position: absolute;
		border-radius: 999px;
		filter: blur(40px);
		opacity: 0.9;
		animation: float 12s ease-in-out infinite;
	}

	.aurora-one {
		width: 28rem;
		height: 28rem;
		background: rgba(56, 189, 248, 0.28);
		top: -8rem;
		right: -6rem;
	}

	.aurora-two {
		width: 22rem;
		height: 22rem;
		background: rgba(244, 114, 182, 0.18);
		bottom: -7rem;
		left: -5rem;
		animation-delay: -4s;
	}

	.card {
		position: relative;
		z-index: 1;
		width: min(100%, 760px);
		padding: clamp(28px, 5vw, 56px);
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 32px;
		background: rgba(8, 15, 30, 0.72);
		backdrop-filter: blur(20px);
		box-shadow:
			0 20px 80px rgba(0, 0, 0, 0.45),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.eyebrow {
		margin: 0 0 18px;
		text-transform: uppercase;
		letter-spacing: 0.28em;
		font-size: 0.77rem;
		color: #7dd3fc;
	}

	.status-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		margin-bottom: 20px;
	}

	.code {
		font-size: clamp(4.8rem, 15vw, 9rem);
		line-height: 0.9;
		font-weight: 800;
		letter-spacing: -0.08em;
		background: linear-gradient(135deg, #e2e8f0 0%, #67e8f9 40%, #f9a8d4 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.orb {
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: linear-gradient(135deg, #67e8f9, #f472b6);
		box-shadow: 0 0 24px rgba(103, 232, 249, 0.5);
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.4rem);
		line-height: 1.02;
		letter-spacing: -0.05em;
		max-width: 12ch;
	}

	.lede {
		margin: 18px 0 0;
		max-width: 58ch;
		font-size: 1.04rem;
		line-height: 1.7;
		color: rgba(226, 232, 240, 0.82);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 30px;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 20px;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
		transition:
			transform 160ms ease,
			background 160ms ease,
			border-color 160ms ease;
	}

	.actions a:hover {
		transform: translateY(-1px);
	}

	.primary {
		background: linear-gradient(135deg, #67e8f9 0%, #a78bfa 100%);
		color: #08111f;
		box-shadow: 0 12px 28px rgba(103, 232, 249, 0.22);
	}

	.secondary {
		color: #e2e8f0;
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: rgba(255, 255, 255, 0.04);
	}

	.hint {
		margin: 22px 0 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: rgba(148, 163, 184, 0.92);
	}

	@keyframes float {
		0%,
		100% {
			transform: translate3d(0, 0, 0) scale(1);
		}

		50% {
			transform: translate3d(0, -18px, 0) scale(1.04);
		}
	}

	@media (max-width: 640px) {
		.page-shell {
			padding: 16px;
		}

		.card {
			padding: 24px;
			border-radius: 24px;
		}

		.status-row {
			gap: 12px;
		}

		.orb {
			width: 14px;
			height: 14px;
		}

		.actions a {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.aurora,
		.actions a {
			animation: none;
			transition: none;
		}
	}
</style>
