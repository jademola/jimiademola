---
import Favicon from "../assets/Favicon.astro";

const { title = "Jimi Ademola", ...props } = Astro.props;
---

<link rel="sitemap" href="/sitemap-index.xml" />
<title>{title}</title>
<meta name="description" content="whoami" />

<!-- Web analytics -->
<script
    data-goatcounter="https://jimi.goatcounter.com/count"
    async
    src="//gc.zgo.at/count.js"></script>

<!-- Open Graph tags -->
<meta property="og:title" content="Jimi Ademola" />
<meta property="og:type" content="website" />
<meta property="og:url" content="http://www.jimiademola.com/" />
<meta property="og:description" content="whoami" />
<meta property="og:image" content="https://jimi-ademola.dev/jimi-ademola-og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />


<Favicon />
